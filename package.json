{
  "name": "terminal-threads",
  "displayName": "Terminal Threads",
  "description": "Independent terminal threads in the sidebar, with history kept across restarts.",
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "sidebar",
    "threads",
    "agents",
    "zed"
  ],
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.146.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "terminalThreads",
          "title": "Terminal Threads",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "terminalThreads": [
        {
          "type": "webview",
          "id": "terminalThreads.view",
          "name": "Threads"
        }
      ]
    },
    "commands": [
      {
        "command": "terminalThreads.new",
        "title": "New Thread",
        "icon": "$(add)"
      },
      {
        "command": "terminalThreads.rename",
        "title": "Rename"
      },
      {
        "command": "terminalThreads.clearHistory",
        "title": "Clear History"
      },
      {
        "command": "terminalThreads.moveUp",
        "title": "Move Up"
      },
      {
        "command": "terminalThreads.moveDown",
        "title": "Move Down"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "terminalThreads.new",
          "when": "view == terminalThreads.view",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "terminalThreads.rename",
          "when": "webviewId == 'terminalThreads.view' && webviewSection == 'thread'",
          "group": "1_thread@1"
        },
        {
          "command": "terminalThreads.clearHistory",
          "when": "webviewId == 'terminalThreads.view' && webviewSection == 'thread'",
          "group": "1_thread@2"
        },
        {
          "command": "terminalThreads.moveUp",
          "when": "webviewId == 'terminalThreads.view' && webviewSection == 'thread'",
          "group": "2_move@1"
        },
        {
          "command": "terminalThreads.moveDown",
          "when": "webviewId == 'terminalThreads.view' && webviewSection == 'thread'",
          "group": "2_move@2"
        }
      ],
      "commandPalette": [
        {
          "command": "terminalThreads.rename",
          "when": "false"
        },
        {
          "command": "terminalThreads.clearHistory",
          "when": "false"
        },
        {
          "command": "terminalThreads.moveUp",
          "when": "false"
        },
        {
          "command": "terminalThreads.moveDown",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Threads",
      "properties": {
        "terminalThreads.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 6,
          "maximum": 100,
          "markdownDescription": "Font size for terminal threads. Unset follows `#terminal.integrated.fontSize#`."
        },
        "terminalThreads.saveHistory": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save each thread's history (encrypted) so it comes back after a restart. Turning this off deletes saved history; threads still come back, empty."
        },
        "terminalThreads.historyEncryption": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "on",
          "scope": "machine",
          "enumDescriptions": [
            "Encrypt saved history with a key kept in VS Code's secret storage.",
            "Save history as readable files (owner-only). Anything printed in a thread, secrets included, is stored in plain text."
          ],
          "markdownDescription": "Encrypt saved thread history. `off` stores it as readable owner-only files, which is useful with Remote-SSH from several computers or without a keyring, but keeps any secrets printed in a thread in plain text. User settings only: a workspace can't change it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc",
    "package": "for t in darwin-arm64 darwin-x64 linux-x64 linux-arm64; do vsce package --target $t || exit 1; done",
    "e2e": "node --test --test-concurrency=1 e2e/*.e2e.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.2.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "26.6.8",
    "@types/vscode": "1.146.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abendrothj/terminal-threads.git"
  },
  "bugs": {
    "url": "https://github.com/abendrothj/terminal-threads/issues"
  }
}
